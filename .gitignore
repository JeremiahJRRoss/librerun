# Runtime output: file storage and the JSON log stream (FILE_STORAGE_PATH
# and LOG_FILE_PATH in backend/app/config.py). Created at runtime, never
# source. Both spellings: the backend writes ./data when run from
# backend/, and compose bind-mounts ./data at the repository root (the
# smoke job tails ./data/logs/backend.jsonl from the host). Only the
# first was ignored, so a local run left log lines staged.
backend/data/
/data/

# The Python-packaging ``lib/`` rule above matches ANY directory named lib,
# which silently excluded frontend/src/lib (api/auth/toast modules) from
# every commit and broke fresh-clone builds. Re-include app source dirs
# named lib. (Both lines are needed: the first un-ignores the directory
# itself, the second its contents.)
!frontend/src/lib/
!frontend/src/lib/**

# Derived by compose.sh before every command from the LIBRERUN_AGENT_KEY_*
# variables of the environment and lines of .env, and from nothing else
# in either (blueprint S4a; K3): the gateway holds the provider
# credentials, so handing it the whole .env would hand it APP_SECRET_KEY
# and the bootstrap credentials too.
agent-keys.env

# The gateway's own secrets: the three provider credentials, loaded by
# the gateway service alone (K1, decision L28). Written by hand from
# gateway.env.example, which IS tracked. Ignored by name rather than by
# a `*.env` glob, so a new secrets file has to be added here on purpose.
gateway.env

# The observability vendor's credentials (blueprint S7a): loaded by
# `env_file: required: false` on vector and otel-bridge alone, so the
# backend, the gateway and the frontend never hold somebody else's
# API key. Two files, one per process (L28: no process receives a
# secret it does not read) — vector reads the log leg's, otel-bridge the
# trace leg's. Both have committed .example templates.
observability.env
observability-traces.env

# Secrets delivered as files (K2, decision L30): the directory the
# `compose.secrets.yaml` overlay in docs/Install.md mounts from, and the
# overlay itself, which a deployment writes from that document's
# example. Nothing here is ever committed — that is the whole point of
# keeping a value in a file instead of in .env.
/secrets/
compose.secrets.yaml

# The edge's certificate and key, when the operator brings their own (K
# blueprint T1): compose mounts LIBRERUN_TLS_CERT_DIR, by default ./tls,
# read-only into the edge. The directory ships empty, because Podman
# refuses a bind-mount source that does not exist; nothing put in it is
# ever committed.
/tls/*
!/tls/.gitkeep

# Git bundles from scripts/prepare_public_repo.sh: the public repository's
# first commit, built on demand and pushed by a person (blueprint S9, L21).
# Committing one would put a copy of the whole tree inside the tree.
*.bundle
